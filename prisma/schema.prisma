// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum UserRole {
  SUPER_ADMIN
  OWNER
  STAFF
  CUSTOMER
}

enum Status {
  ACTIVE
  INACTIVE
  PAUSED
  DELETED
  EXPIRED
  CANCELLED
}

//////////////////////////////////////////////////////
// MODELS
//////////////////////////////////////////////////////

model Company {
  id          String   @id @default(uuid())
  name        String
  companyCode String   @unique
  ownerName   String?
  mobile      String?
  address     String?
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
  createdBy   String?
  updatedBy   String?

  users                User[]
  products             Product[]
  userProducts         UserProduct[]
  dailyEntries         DailyEntry[]
  userPayments         UserPayment[]
  subscription         CompanySubscription?
  subscriptionPayments CompanySubscriptionPayment[]

  @@map("company")
}

//////////////////////////////////////////////////////

model User {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  mobile       String
  customerCode String?
  email        String?  @unique
  passwordHash String
  role         UserRole
  status       Status   @default(ACTIVE)
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime? @updatedAt
  createdBy    String?
  updatedBy    String?

  company         Company                      @relation(fields: [companyId], references: [id])
  userProducts    UserProduct[]
  dailyEntries    DailyEntry[]
  payments        UserPayment[]
  handledPayments CompanySubscriptionPayment[] @relation("HandledBy")

  @@unique([companyId, mobile])
  @@unique([companyId, customerCode])
  @@map("user")
}

//////////////////////////////////////////////////////

model Product {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  productCode String?
  description String?
  unit        String
  price       Decimal  @db.Decimal(10, 2)
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
  createdBy   String?
  updatedBy   String?

  company      Company       @relation(fields: [companyId], references: [id])
  userProducts UserProduct[]
  dailyEntries DailyEntry[]

  @@unique([companyId, name])
  @@unique([companyId, productCode])
  @@map("product")
}

//////////////////////////////////////////////////////

model UserProduct {
  id          String   @id @default(uuid())
  companyId   String
  userId      String
  productId   String
  defaultQty  Decimal  @db.Decimal(10, 2)
  customPrice Decimal? @db.Decimal(10, 2)
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
  createdBy   String?
  updatedBy   String?

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([companyId, userId, productId])
  @@map("user_product")
}

//////////////////////////////////////////////////////

model DailyEntry {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  productId String
  entryDate DateTime @db.Date
  quantity  Decimal  @db.Decimal(10, 2)
  price     Decimal  @db.Decimal(10, 2)
  amount    Decimal  @db.Decimal(10, 2)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
  createdBy String?
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("daily_entry")
}

//////////////////////////////////////////////////////

model UserPayment {
  id          String   @id @default(uuid())
  companyId   String
  userId      String
  amount      Decimal  @db.Decimal(10, 2)
  paymentDate DateTime @db.Date
  paymentMode String
  note        String?
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
  createdBy   String?
  updatedBy   String?

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("user_payment")
}

//////////////////////////////////////////////////////

model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String
  price        Decimal  @db.Decimal(10, 2)
  durationDays Int
  maxCustomers Int
  maxAdmins    Int      @default(1)
  description  String?
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime? @updatedAt
  createdBy    String?
  updatedBy    String?

  subscriptions CompanySubscription[]
  payments      CompanySubscriptionPayment[]

  @@map("subscription_plan")
}

//////////////////////////////////////////////////////

model CompanySubscription {
  id        String   @id @default(uuid())
  companyId String   @unique
  planId    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
  createdBy String?
  updatedBy String?

  company Company          @relation(fields: [companyId], references: [id])
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("company_subscription")
}

//////////////////////////////////////////////////////

model CompanySubscriptionPayment {
  id          String   @id @default(uuid())
  companyId   String
  planId      String
  amount      Decimal  @db.Decimal(10, 2)
  paymentDate DateTime @db.Date
  paymentMode String
  reference   String?
  handledById String
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
  createdBy   String?
  updatedBy   String?

  company   Company          @relation(fields: [companyId], references: [id])
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  handledBy User             @relation("HandledBy", fields: [handledById], references: [id])

  @@map("company_subscription_payment")
}
